    "test:track:browser": "node test/track-browser.cjs",
    "test:editor:browser": "node test/editor-browser.cjs",
    "test:materials:browser": "node test/materials-browser.cjs",
    "test:workspaces:browser": "node test/workspaces-browser.cjs",
    "test:szs:browser": "node test/szs-browser.cjs",
    "test:backfaces:browser": "node test/backfaces-browser.cjs",
    "test:creases:browser": "node test/creases-browser.cjs",
    "test:track-editor:browser": "node test/track-editor-browser.cjs",
    "test:uv-controls:browser": "node test/uv-controls-browser.cjs",
    "test:knife:browser": "node test/knife-browser.cjs",
    "test:quick-extrude:browser": "node test/quick-extrude-browser.cjs"
